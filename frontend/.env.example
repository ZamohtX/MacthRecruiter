# URL do backend usada pelo proxy do Vite em desenvolvimento.
BACKEND_URL=http://localhost:8000

# Em produção o frontend é servido separado do backend: informe a URL absoluta.
# Em desenvolvimento deixe vazio para usar o proxy (mesma origem, sem CORS).
VITE_API_BASE_URL=

# Client ID do Google OAuth. Vazio ativa o modo mock, que casa com o
# GOOGLE_CLIENT_ID=mock_google_client_id do backend.
VITE_GOOGLE_CLIENT_ID=
