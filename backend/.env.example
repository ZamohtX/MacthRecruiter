# Ambiente. Em "production" o login simulado do Google é desligado e a API se
# recusa a subir com os valores de desenvolvimento abaixo.
ENVIRONMENT=development

# Banco de dados (asyncpg). Em docker compose o host é "db".
# No Cloud SQL via socket Unix o formato muda:
#   postgresql+asyncpg://usuario:senha@/matchrecruiter?host=/cloudsql/PROJETO:REGIAO:INSTANCIA
DATABASE_URL=postgresql+asyncpg://matchuser:matchpassword@localhost:5432/matchrecruiter

# JWT local emitido após o login Google
SECRET_KEY=change_me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Client ID do Google OAuth. Mantenha "mock_google_client_id" para usar os
# tokens simulados (mock_google_token_<sufixo>) em desenvolvimento e demo.
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Origens permitidas no CORS. Use a origem exata do frontend em produção —
# o navegador rejeita "*" junto com credenciais.
CORS_ORIGINS=["*"]

# Cria/atualiza o questionário padrão de 10 soft skills na subida da aplicação.
# Em produção deixe false: quem faz isso é o job de release (scripts/release.sh).
AUTO_SEED=true

# Pool de conexões (só PostgreSQL). Cada instância do Cloud Run segura
# DB_POOL_SIZE conexões — multiplique pelo máximo de instâncias e compare com
# o limite da instância do Cloud SQL antes de aumentar.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=0
DB_POOL_RECYCLE=1800

# API pública de Desenvolvedores do OxeTech Academy (empresas ↔ alunos).
# Gere o token no painel de Desenvolvedores do Academy — ele aparece uma única
# vez. Sem token, a integração fica inerte e a demo usa o roster sintético.
ACADEMY_API_BASE_URL=https://oxetech.al.gov.br/api/dev/v1
ACADEMY_API_TOKEN=oxedev_seu_token_aqui

# Google Gemini — resumo do candidato por IA. Gere a chave no Google AI Studio.
# Sem chave, o endpoint de resumo cai para um texto-regra (o produto segue funcionando).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
