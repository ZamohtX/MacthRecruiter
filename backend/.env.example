# Banco de dados (asyncpg). Em docker compose o host é "db".
DATABASE_URL=postgresql+asyncpg://matchuser:matchpassword@localhost:5432/matchrecruiter

# JWT local emitido após o login Google
SECRET_KEY=change_me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Client ID do Google OAuth. Mantenha "mock_google_client_id" para usar os
# tokens simulados (mock_google_token_<sufixo>) em desenvolvimento e demo.
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Origens permitidas no CORS. Use a origem exata do frontend em produção —
# o navegador rejeita "*" junto com credenciais.
CORS_ORIGINS=["*"]

# Cria/atualiza o questionário padrão de 10 soft skills na subida da aplicação.
AUTO_SEED=true

# API pública de Desenvolvedores do OxeTech Academy (empresas ↔ alunos).
# Gere o token no painel de Desenvolvedores do Academy — ele aparece uma única
# vez. Sem token, a integração fica inerte e a demo usa o roster sintético.
ACADEMY_API_BASE_URL=https://oxetech.al.gov.br/api/dev/v1
ACADEMY_API_TOKEN=oxedev_seu_token_aqui
